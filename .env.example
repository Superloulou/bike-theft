# Copier ce fichier en .env puis adapter les valeurs.
# Le site de démonstration n'utilise aucune de ces variables pour fonctionner :
# elles ne servent qu'à piloter le serveur (et le back-end dormant).

# Port écouté par `next start`
PORT=3000

# Interface écoutée (0.0.0.0 = accessible depuis le réseau local)
HOSTNAME=0.0.0.0

NODE_ENV=production

# Back-end dormant uniquement : chemin de la base SQLite.
# Aucune déclaration n'est enregistrée dans la maquette.
DATABASE_FILE=./data/reports.db
